# Copy to .env and fill in values. Never commit .env.

# --- Auth (production: token or header, not dev) ---
SECURE_QUERY_AUTH_MODE=dev
SECURE_QUERY_PRINCIPAL_ID=demo-user
SECURE_QUERY_TENANT_ID=chinook
# SECURE_QUERY_ALLOWED_TABLES=Invoice,Customer
# SECURE_QUERY_PRINCIPALS_FILE=config/principals.json
# SECURE_QUERY_API_TOKENS={"your-api-token":{"principal_id":"alice","allowed_tables":["Invoice"]}}

# --- Catalog (default: Chinook sample_catalog) ---
# SECURE_QUERY_CATALOG_FILE=config/my-domain-catalog.json
# SECURE_QUERY_AUDIT_PATH=data/audit.jsonl

# --- Execute backend: omit Databricks vars for local DuckDB ---
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
# DATABRICKS_TOKEN=dapi...

# --- LLM planner (optional; mock if unset) ---
# SECURE_QUERY_PROVIDER=ollama
# SECURE_QUERY_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
