# Copy to .env and fill in values. Never commit .env.

# --- Auth (production: token or header, not dev) ---
SECURE_QUERY_AUTH_MODE=dev
SECURE_QUERY_PRINCIPAL_ID=demo-user
SECURE_QUERY_TENANT_ID=chinook
# SECURE_QUERY_ALLOWED_TABLES=Invoice,Customer
# SECURE_QUERY_PRINCIPALS_FILE=config/principals.json
# SECURE_QUERY_API_TOKENS={"your-api-token":{"principal_id":"alice","allowed_tables":["Invoice"]}}

# --- Catalog (default: Chinook sample_catalog) ---
# SECURE_QUERY_CATALOG_FILE=config/my-domain-catalog.json
# SECURE_QUERY_AUDIT_PATH=data/audit.jsonl

# --- Execute backend: omit Databricks vars for local DuckDB ---
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
# DATABRICKS_TOKEN=dapi...

# --- Knowledge overlay (instructions + extra synonyms; never SQL examples) ---
# SECURE_QUERY_KNOWLEDGE_FILE=config/knowledge.example.json

# --- Execute backend: duckdb (default) | databricks | postgres ---
# SECURE_QUERY_BACKEND=duckdb
# SECURE_QUERY_POSTGRES_DSN=postgresql://user:pass@localhost:5432/chinook
# DATABASE_URL=postgresql://user:pass@localhost:5432/chinook

# --- Prompt retrieval (0 = off; auto 8 when catalog has >16 tables) ---
# SECURE_QUERY_RETRIEVE_K=0

# --- Production: never use AUTH_MODE=dev ---
# SECURE_QUERY_ENV=production
# SECURE_QUERY_AUTH_MODE=token
# SECURE_QUERY_PROVIDER=ollama
# SECURE_QUERY_MODEL=qwen2.5:7b
# Eval refuses to run if the Ollama model build differs (tags can be re-pulled):
# SECURE_QUERY_MODEL_DIGEST=845dbda0ea48
# OLLAMA_HOST=http://localhost:11434
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
