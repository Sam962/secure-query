  "metrics": [
    {
      "id": "order_count",
      "description": "Count of orders",
      "source": "Orders",
      "aggregations": [
        "count:*:order_count"
      ],
      "default_limit": 1
    },
    {
      "id": "total_freight",
      "description": "Sum of freight charged on all orders",
      "source": "Orders",
      "aggregations": [
        "sum:Orders.Freight:total_freight"
      ],
      "default_limit": 1,
      "unit": "USD"
    },
    {
      "id": "freight_by_shipper",
      "description": "Total freight grouped by shipper",
      "source": "Orders",
      "joins": [
        "Orders:Shippers:Orders.ShipVia=Shippers.ShipperID"
      ],
      "group_by": [
        "Shippers.CompanyName"
      ],
      "aggregations": [
        "sum:Orders.Freight:freight"
      ],
      "default_limit": 10,
      "unit": "USD"
    },
    {
      "id": "units_sold_by_category",
      "description": "Units sold (order line quantity) grouped by product category",
      "source": "Order Details",
      "joins": [
        "Order Details:Products:Order Details.ProductID=Products.ProductID",
        "Products:Categories:Products.CategoryID=Categories.CategoryID"
      ],
      "group_by": [
        "Categories.CategoryName"
      ],
      "aggregations": [
        "sum:Order Details.Quantity:units_sold"
      ],
      "default_limit": 20
    }
  ],
  "instructions": [
    "Units sold come from Order Details.Quantity, not Products.UnitsInStock.",
    "Orders.OrderDate is when an order was placed; use it for 'orders in <year>' unless the question says shipped."
  ]
}
